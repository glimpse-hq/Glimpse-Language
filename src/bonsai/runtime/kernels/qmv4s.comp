#version 460
#include "common.glsl"
#define QMV_SPLIT
#include "qmv.glsl"
// Decode matvec (one token) for long K (the MLP down projection): 4 rows per workgroup, K split over 4
// subgroups, optional LoRA epilogue.
// Grid O / 4 (the Vulkan layer sets it).
layout(local_size_x = 128) in;
layout(push_constant) uniform P { PTR W; PTR S; PTR x; PTR y; uint K; uint O; uint add; PTR B; PTR u; uint lr; } pc;
void main() {
    qmv_split4(pc.W, pc.S, pc.x, pc.y, pc.K, gl_WorkGroupID.x * 4u, pc.add, pc.B, pc.u, 0u, pc.lr);
}
